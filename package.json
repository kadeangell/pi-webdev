{
  "name": "pi-webdev",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestration system for LLM-driven web development",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test && pnpm smoke",
    "smoke": "node --enable-source-maps scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "eslint": "^10.4.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  }
}
