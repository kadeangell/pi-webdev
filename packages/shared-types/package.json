{
  "name": "@pi-webdev/shared-types",
  "version": "0.1.0",
  "description": "WDP (WebDev Protocol) wire types, capability shapes, and error codes shared by the pi-webdev server and clients.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadeangell/pi-webdev.git",
    "directory": "packages/shared-types"
  },
  "homepage": "https://github.com/kadeangell/pi-webdev",
  "keywords": ["pi-webdev", "wdp", "protocol", "types"],
  "publishConfig": { "access": "public" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
