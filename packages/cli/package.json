{
  "name": "@pi-webdev/cli",
  "version": "0.1.0",
  "description": "pi-webdev command line — init a project, run or install the daemon, and drive the orchestration server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadeangell/pi-webdev.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/kadeangell/pi-webdev",
  "keywords": ["pi-webdev", "cli", "wdp"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22" },
  "bin": {
    "pi-webdev": "./dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pi-webdev/shared-types": "workspace:*",
    "@pi-webdev/server": "workspace:*",
    "@pi-webdev/coding-agent": "workspace:*"
  }
}
