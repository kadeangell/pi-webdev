{
  "name": "@pi-webdev/server",
  "version": "0.1.0",
  "description": "pi-webdev orchestration server — supervises browser (Lightpanda), file watcher, TypeScript LSP, Vite, Vitest, and ESLint subsystems behind the WebDev Protocol.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kadeangell/pi-webdev.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/kadeangell/pi-webdev",
  "keywords": ["pi-webdev", "wdp", "llm", "coding-agent", "lightpanda", "orchestration"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22" },
  "bin": {
    "pi-webdev-server": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@pi-webdev/shared-types": "workspace:*",
    "chokidar": "^4.0.3",
    "esbuild": "^0.24.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  }
}
